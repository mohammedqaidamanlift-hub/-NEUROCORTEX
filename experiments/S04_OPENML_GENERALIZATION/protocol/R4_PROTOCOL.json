  "r4_failure_contract": {
    "terminal_statuses": [
      "NOT_TRIGGERED",
      "TRIGGERED",
      "GENERATOR_EMPTY",
      "SUCCESS",
      "SYSTEM_FAILURE",
      "INFRASTRUCTURE_ERROR",
      "EXPERIMENT_HARNESS_ERROR",
      "DATA_ERROR",
      "DEPENDENCY_ERROR",
      "INCOMPLETE",
      "INTERRUPTED"
    ],
    "status_semantics": {
      "NOT_TRIGGERED": "Eligible fold with IR < 3.0. Valid experimental outcome; Generator is not invoked.",
      "TRIGGERED": "Eligible fold with IR >= 3.0 entering the authoritative SRDF path.",
      "GENERATOR_EMPTY": "Triggered case where Generator returns no candidate. This is a valid recorded outcome and not an automatic failure.",
      "SUCCESS": "Authoritative SRDF execution reaches terminal successful completion with all required records and invariants satisfied.",
      "SYSTEM_FAILURE": "Failure in the authoritative SRDF execution path after trigger.",
      "INFRASTRUCTURE_ERROR": "Execution environment or infrastructure prevents normal execution.",
      "EXPERIMENT_HARNESS_ERROR": "Runner/orchestration/harness defect prevents valid experimental execution.",
      "DATA_ERROR": "Dataset acquisition, target, schema, or data integrity problem prevents valid execution.",
      "DEPENDENCY_ERROR": "Required software/dependency failure prevents valid execution.",
      "INCOMPLETE": "Case started or was active but did not reach a terminal scientific result before execution/session loss.",
      "INTERRUPTED": "Execution was externally interrupted before terminal completion."
    },
    "automatic_retry": false,
    "automatic_reclassification": false,
    "post_result_reclassification": false,
    "method_change_after_failure": false,
    "parameter_change_after_failure": false,
    "dataset_substitution_after_failure": false,
